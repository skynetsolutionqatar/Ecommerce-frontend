# Every variable here is NEXT_PUBLIC_* and is inlined into the browser bundle.
# Never put API keys, secrets or credentials in this file.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:5050/api/v1

# Tenant the storefront renders
NEXT_PUBLIC_TENANT_ID=your-tenant-id
NEXT_PUBLIC_TENANT_SLUG=skynet

# Branding profile in config/clients
NEXT_PUBLIC_CLIENT_ID=skynet

# Google OAuth client id (public half only — the secret stays on the backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Admin dashboard clock
NEXT_PUBLIC_CLOCK_TIMEZONE=Asia/Qatar
NEXT_PUBLIC_CLOCK_TIMEZONE_LABEL=Doha
