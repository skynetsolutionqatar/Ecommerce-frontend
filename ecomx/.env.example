# Every variable here is NEXT_PUBLIC_* and is inlined into the browser bundle.
# Never put API keys, secrets or credentials in this file.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:5050/api/v1

# Tenant the storefront renders
NEXT_PUBLIC_TENANT_ID=your-tenant-id
NEXT_PUBLIC_TENANT_SLUG=skynet

# This deployment's public storefront URL (matches tenant clientUrl in admin)
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# Branding profile in config/clients
NEXT_PUBLIC_CLIENT_ID=skynet

# Google OAuth client id (public half only — the secret stays on the backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Admin dashboard clock
NEXT_PUBLIC_CLOCK_TIMEZONE=Asia/Qatar
NEXT_PUBLIC_CLOCK_TIMEZONE_LABEL=Doha

# --- Universal Links / Android App Links (server-only; not NEXT_PUBLIC) ---
# Apple Developer Team ID (10 chars). Required for /.well-known/apple-app-site-association
# Find it: Apple Developer → Membership details, or `eas credentials -p ios`
# APPLE_TEAM_ID=
#
# Comma-separated SHA-256 fingerprints for production signing certs
# (EAS upload keystore + Play App Signing). Debug keystore is always included by the route.
# Get EAS upload SHA-256: `eas credentials -p android` → Keystore → Fingerprints
# Get Play App Signing SHA-256: Play Console → App integrity → App signing
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:…,CC:DD:…
